APP_NAME=Match-MA API
APP_ENV=development
DEBUG=true

# Example:
# DATABASE_URL=postgresql+psycopg://match_ma:match_ma@localhost:5432/match_ma
DATABASE_URL=

# Comma-separated origins for local frontend development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required only when model API keys are entered directly in AI Settings.
# Use one Fernet key and keep the same value on the API and LLM worker services.
MODEL_SECRET_ENCRYPTION_KEY=
