APP_NAME=Match-MA API
APP_ENV=development
DEBUG=true

# Example:
# DATABASE_URL=postgresql+psycopg://match_ma:match_ma@localhost:5432/match_ma
DATABASE_URL=

# Comma-separated origins for local frontend development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Auth hardening -----------------------------------------------------
# Production must set all four values below; missing/default values are
# logged as [auth-warning] at startup. With AUTH_STRICT=true (or
# APP_ENV=production) the app refuses to start until they are fixed.
AUTH_ENABLED=false
AUTH_STRICT=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string; the legacy admin token used by scripts.
ADMIN_TOKEN=
# Long random string; signs user login JWTs.
AUTH_JWT_SECRET=
# Login JWT lifetime in seconds. Default: 604800 (7 days). This affects newly issued
# JWTs for every user, not only external skills.
AUTH_TOKEN_TTL_SECONDS=604800

# Required only when model API keys are entered directly in AI Settings.
# Use one Fernet key and keep the same value on the API and LLM worker services.
MODEL_SECRET_ENCRYPTION_KEY=
