# Match-MA 自建部署环境变量模板
# 用法：cp .env.example .env && chmod 600 .env  然后把空值填满。
# 真实 .env 已被 .gitignore 排除，绝不要提交到仓库（仓库是公开的）。

# ==================== 数据库 ====================
POSTGRES_USER=match_ma
POSTGRES_DB=match_ma
# 必填。只用 URL 安全字符（字母数字和 - _），不要含 @ : / # ? 否则连接串会被解析错。
POSTGRES_PASSWORD=

# 注意：DATABASE_URL 由 docker-compose.yml 从上面三个变量自动拼装，
# 不要在本文件里设置，设了也不生效。

# ==================== 应用 ====================
APP_NAME=Match-MA API
APP_ENV=production
DEBUG=false
# 前后端经 Caddy 反代做成同源，实际用不到 CORS。
CORS_ORIGINS=*

# ==================== 鉴权 ====================
# APP_ENV=production 会开启严格模式：下面几项缺失或用默认值时，应用拒绝启动。
# 这是保护机制，不是故障。
AUTH_ENABLED=true
ADMIN_USERNAME=admin
# 必填，强随机：python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=
# 必填，脚本用的静态令牌：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=
# 必填，登录 JWT 签名密钥：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# 登录 JWT 有效期，单位秒。默认 604800（7 天），只影响之后新签发的 JWT，
# 不会延长已有令牌。Railway 生产环境请在服务变量中设置同名变量。
AUTH_TOKEN_TTL_SECONDS=604800

# ==================== 模型密钥加密 ====================
# 加密数据库里存的模型 API key。API 与所有 worker 必须一致 ——
# 本文件被所有服务共用，因此天然一致，不要单独覆盖。
# 生成：docker run --rm python:3.12-slim sh -c "pip install -q cryptography && python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"
MODEL_SECRET_ENCRYPTION_KEY=

# ==================== 附件存储（MinIO）====================
MINIO_ROOT_USER=matchma
# 必填，至少 8 位：python3 -c "import secrets;print(secrets.token_urlsafe(24))"
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=match-ma-attachments
# s3 = 用 MinIO（默认）；改成 local 则切回本地卷存储。
ATTACHMENT_STORAGE_BACKEND=s3

# ==================== OCR ====================
# 不需要 PDF/扫描件 OCR 就保持 skeleton（占位，不真跑）。
# 要用则改成 doc2x 并填下面的 key。
OCR_PROVIDER=skeleton
DOC2X_API_KEY=

# ==================== 前端 ====================
# 相对路径 = 与 API 同源，免 CORS。
# 这是构建期变量，改动后必须重新 build 前端镜像才生效。
VITE_API_BASE_URL=/api/v1
