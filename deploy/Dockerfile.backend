# Match-MA 后端镜像：API 与 3 个 worker 共用同一镜像，仅启动命令不同。
# 构建上下文是仓库根目录（见 docker-compose.yml 的 context: ..）。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

WORKDIR /app

# 依赖说明：psycopg[binary] / cryptography / pillow / pydantic-core 均有
# manylinux wheel，slim 基础镜像无需安装编译工具链。
COPY pyproject.toml ./
COPY backend/ ./backend/
COPY alembic/ ./alembic/
COPY alembic.ini ./
COPY database/ ./database/
COPY scripts/ ./scripts/

RUN pip install --no-cache-dir .

# 本地卷存储模式下的附件根目录；MinIO 模式下不使用，保留以便随时切回。
RUN mkdir -p /app/storage/attachments

EXPOSE 8000

# 默认起 API；worker 在 docker-compose.yml 里用 command 覆盖。
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
