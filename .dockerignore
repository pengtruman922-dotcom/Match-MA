# Docker 构建上下文排除项（上下文 = 仓库根目录）
.git/
.github/
.claude/

# Python
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / 前端产物
node_modules/
**/node_modules/
frontend/dist/
dist/
build/

# 本地运行时数据
storage/

# 环境变量：绝不进镜像。
# 尤其 frontend/.env 指向 Railway 地址，进了构建上下文会污染自建前端的 API 地址。
**/.env
**/.env.*
!**/.env.example
.match-ma-local-auth.json

# 文档与测试不需要进镜像
docs/
tests/
