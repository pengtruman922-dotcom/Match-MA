:{$PORT:8080} {
  root * /app/dist
  encode gzip

  @assets path /assets/*
  handle @assets {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle {
    try_files {path} /index.html
    header Cache-Control "no-cache, no-store, must-revalidate"
    file_server
  }
}
